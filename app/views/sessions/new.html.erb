<h1 class="text-center mt-4"><%= t '.title' %></h1>



<%= form_with(scope: :session, url: login_path, local: true) do |form| %>
  <div class="col-12">
    <div class="row mb-3 justify-content-center">
    <%= form.label t('.name'), class: "col-sm-1 col-form-label required", style: "color: #515a5a; font-weight: bold" %>
    <div class="col-sm-3">
      <%= form.text_field :name, class: "form-control", placeholder: t('.name_placeholder'), required: true %>
      </div> 
  </div>

  <div class="col-12">
    <div class="row mb-3 justify-content-center">
    <%= form.label t('.password'), class: "col-sm-1 col-form-label required", style: "color: #515a5a; font-weight: bold" %>
    <div class="col-sm-3">
      <%= form.password_field :password, class: "form-control", placeholder: t('.password_placeholder'), required: true  %>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <%= form.submit t('.submit'), class: "btn", style: "color: #515a5a; font-weight: bold; background-color: #d5dbdb" %>
  </div>
<% end %>


