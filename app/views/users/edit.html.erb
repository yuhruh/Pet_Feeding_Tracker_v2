<h1 class="text-center mt-4">
  <%= t(".edit_title", name: (@user.name.split(' ').map(&:capitalize).join(' '))) %>
</h1>

<%= form_with(model: @user) do |form| %>
  <div class="d-flex justify-content-center">
    <%= render 'shared/errors', obj: @user %>
  </div>

  <div class="col-12">
    <div class="row mb-3 justify-content-center">
    <%= form.label t('.name'), class: "col-sm-2 col-form-label", style: "color: #515a5a; font-weight: bold" %>
    <div class="col-sm-3">
      <%= form.text_field :name, class: "form-control", value: @user.name, :required => true %>
      </div> 
  </div>

  <div class="col-12">
    <div class="row mb-3 justify-content-center">
      <%= form.label t('.password'), class: "col-sm-2 col-form-label required", style: "color: #515a5a; font-weight: bold" %>
      <div class="col-sm-3">
        <%= form.password_field :password, class: "form-control", placeholder: t('.password_placeholder'), :required => true %>
    </div>
  </div>

  <div class="col-12">
    <div class="row mb-3 justify-content-center">
      <%= form.label t('.password_confirmation'), class: "col-sm-2 col-form-label required", style: "color: #515a5a; font-weight: bold" %>
      <div class="col-sm-3">
      <%= form.password_field :password_confirmation, class: "form-control", placeholder: t('.password_confirmation_placeholder'), :required => true %>
    </div>
  </div>

  <div class="col-12">
    <div class="row mb-3 justify-content-center" data-controller="time-zone">
      <%= form.label t('.time_zone'), class: "col-sm-2 col-form-label", style: "color: #515a5a; font-weight: bold" %>
      <div class="col-sm-3">
        <fieldset disabled>
          <%= form.text_field :time_zone, data: @user.time_zone, id: "disabledTextInput", class: "form-control" %>
        </fieldset>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <%= form.submit(@user.new_record? ? t('.submit.create') : t('.submit.update'), class: "btn", style: "color: #515a5a; font-weight: bold; background-color: #d5dbdb") %>
  </div>
<% end %>