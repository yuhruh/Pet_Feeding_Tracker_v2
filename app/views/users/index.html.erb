<h1 class="text-center mt-4">Users</h1>

<div class="d-flex digg_pagination justify-content-center">
  <div class="page_info">
    <%= page_entries_info @users %>
  </div>
</div>
<div class="d-flex digg_pagination justify-content-center mb-4">
  <%= will_paginate @users, :container => false %>
</div>

<div id="users" class="d-flex justify-content-center">
  <% @users.each do |user| %>
    <div class="card mb-3" style="width: 40rem; background: #f2f4f6">
      <%= render user %>
      <p class="text-center">
        <%= link_to "Show this user", user %>
      </p>
    </div>
  <% end %>
</div>