<table class="table table-bordered" style="width:100%">
  <thead class="table-dark">
    <tr class='text-center justify-content-center'>
      <th scope="col" style="width:1%"><%= t(".number") %></th>
      <th scope="col" style="width:5%"><%= t(".date") %></th>
      <th scope="col" style="width:6%"><%= t(".feeding_time") %></th>
      <th scope="col" style="width:8%"><%= t(".eat_asap") %></th>
      <th scope='col' style="width:10%"><%= t(".record_time") %></th>
      <th scope='col' style="width:5%"><%= t(".food_type") %></th>
      <th scope="col"><%= t(".brand") %></th>
      <th scope="col"><%= t(".description") %></th>
      <th scope="col" style="width:5%"><%= t(".amount") %></th>
      <th scope="col" style="width:6%"><%= t(".left_amount") %></th>
      <th scope="col" style="width:6%"><%= t(".total_ate_amount") %></th>
      <th scope="col" style="width:5%"><%= t(".result") %></th>
      <th scope="col" style="width:6%"><%= t(".favorite_score") %></th>
      <th scope="col" style="width:6%"><%= t(".weight") %></th>
      <th scope="col"><%= t(".note") %></th>
      <th scope="col"><%= t(".edit") %></th>
      <th scope="col"><%= t(".delete") %></th>
    </tr>
  </thead>
  <tbody class="table-group-divider" id="trackers">
    <% @trackers.order(date: 'asc').each_with_index do |pet_tracker, idx| %>
      <%=Time.zone.parse(pet_tracker.date).strftime("%Y-%m-%d")%>
      <% if pet_tracker.total_ate_amount.nil? %>
        <tr class="table-danger">
          <th scope="row"><%= idx+1 %></th>
          <td><%= pet_tracker.date.strftime("%Y-%m-%d") %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.feeding_time.strftime("%H:%M") %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.hungry_extend %></td>
          <td><%= pet_tracker.time_of_eat_back_and_forth %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.food_type %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.brand %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.description %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.amount %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.left_amount %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.total_ate_amount %></td>
          <% if pet_tracker.hungry_extend == 'Yes' || pet_tracker.hungry_extend == '會' %>
            <td><%= image_tag("heart.png", width: "15px") %> - <%=image_tag(pet_tracker.love_extend.to_s, width:'15px')%></td>
          <% elsif pet_tracker.hungry_extend == 'No' || pet_tracker.hungry_extend == '不會' %>
            <td><%= image_tag("x.png", width: "15px") %> - <%=image_tag(pet_tracker.love_extend.to_s, width:'15px')%></td>
          <% elsif pet_tracker.hungry_extend == 'Ate A Little' || pet_tracker.hungry_extend == '吃一點點' %>
            <td><%= image_tag("triangle.png", width: "15px") %> - <%=image_tag(pet_tracker.love_extend.to_s, width:'15px')%></td>
          <% else %>
            <td><%= pet_tracker.result %></td>
          <% end %>
          <td class="text-center justify-content-center"><%= pet_tracker.favorite_score %></td>
          <td><%= pet_tracker.weight %></td>
          <td><%= pet_tracker.note %></td>
          <td class="text-center justify-content-center"><%= link_to "#{image_tag("icon_edit.png", width:"18px")} Update Left Amount".html_safe, edit_pet_tracker_path(@pet, pet_tracker), 
          class:'link-danger link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover' %></td>
          <td class="text-center justify-content-center"><%= link_to (image_tag("icon_delete.png", width:"18px")), pet_tracker_path(@pet, pet_tracker), data: { turbo_method: :delete, turbo_confirm: t('.are_you_sure') } %></td>
        </tr>
      <% elsif pet_tracker.time_of_eat_back_and_forth.empty? %>
        <tr class="table-warning">
          <th scope="row"><%= idx+1 %></th>
          <td><%= pet_tracker.date.strftime("%Y-%m-%d") %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.feeding_time.strftime("%H:%M") %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.hungry_extend %></td>
          <td><%= pet_tracker.time_of_eat_back_and_forth %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.food_type %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.brand %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.description %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.amount %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.left_amount %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.total_ate_amount %></td>
          <% if pet_tracker.hungry_extend == 'Yes' || pet_tracker.hungry_extend == '會' %>
            <td><%= image_tag("heart.png", width: "15px") %> - <%=image_tag(pet_tracker.love_extend.to_s, width:'15px')%></td>
          <% elsif pet_tracker.hungry_extend == 'No' || pet_tracker.hungry_extend == '不會' %>
            <td><%= image_tag("x.png", width: "15px") %> - <%=image_tag(pet_tracker.love_extend.to_s, width:'15px')%></td>
          <% elsif pet_tracker.hungry_extend == 'Ate A Little' || pet_tracker.hungry_extend == '吃一點點' %>
            <td><%= image_tag("triangle.png", width: "15px") %> - <%=image_tag(pet_tracker.love_extend.to_s, width:'15px')%></td>
          <% else %>
            <td><%= pet_tracker.result %></td>
          <% end %>
          <td class="text-center justify-content-center"><%= pet_tracker.favorite_score %></td>
          <td><%= pet_tracker.weight %></td>
          <td><%= pet_tracker.note %></td>
          <td class="text-center justify-content-center"><%= link_to "#{image_tag("icon_edit.png", width:"18px")} #{t('.update_time_eat')}".html_safe, edit_pet_tracker_path(@pet, pet_tracker),
          class:'link-wanring link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover' %></td>
          <td class="text-center justify-content-center"><%= link_to (image_tag("icon_delete.png", width:"18px")), pet_tracker_path(@pet, pet_tracker), data: { turbo_method: :delete, turbo_confirm: t('.are_you_sure') } %></td>
        </tr>
      <% else %>
        <tr>
          <th scope="row"><%= idx+1 %></th>
          <td><%= pet_tracker.date.strftime("%Y-%m-%d") %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.feeding_time.strftime("%H:%M") %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.hungry_extend %></td>
          <td><%= pet_tracker.time_of_eat_back_and_forth %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.food_type %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.brand %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.description %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.amount %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.left_amount %></td>
          <td class="text-center justify-content-center"><%= pet_tracker.total_ate_amount %></td>
          <% if pet_tracker.hungry_extend == 'Yes' || pet_tracker.hungry_extend == '會' %>
            <% if pet_tracker.frequency > 2 %>
              <td><%= image_tag("heart.png", width: "15px") %> - <%=image_tag(pet_tracker.love_extend.to_s, width:'15px')%><%= image_tag("heart.png", width: "15px") %></td>
            <% else %>
              <td><%= image_tag("heart.png", width: "15px") %> - <%=image_tag(pet_tracker.love_extend.to_s, width:'15px')%></td>
            <% end %>
          <% elsif pet_tracker.hungry_extend == 'No' || pet_tracker.hungry_extend == '不會' %>
            <% if pet_tracker.frequency > 2 %>
              <td><%= image_tag("x.png", width: "15px") %> - <%=image_tag(pet_tracker.love_extend.to_s, width:'15px')%><%= image_tag("heart.png", width: "15px") %></td>
            <% else %>
              <td><%= image_tag("x.png", width: "15px") %> - <%=image_tag(pet_tracker.love_extend.to_s, width:'15px')%></td>
            <% end %>
          <% elsif pet_tracker.hungry_extend == 'Ate A Little' || pet_tracker.hungry_extend == '吃一點點' %>
            <% if pet_tracker.frequency > 2 %>
              <td><%= image_tag("triangle.png", width: "15px") %> - <%=image_tag(pet_tracker.love_extend.to_s, width:'15px')%><%= image_tag("heart.png", width: "15px") %></td>
            <% else %>
              <td><%= image_tag("triangle.png", width: "15px") %> - <%=image_tag(pet_tracker.love_extend.to_s, width:'15px')%></td>
            <% end %>
          <% else %>
            <td><%= pet_tracker.result %></td>
          <% end %>
          <td class="text-center justify-content-center"><%= pet_tracker.favorite_score %></td>
          <td><%= pet_tracker.weight %></td>
          <td><%= pet_tracker.note %></td>
          <td class="text-center justify-content-center"><%= link_to (image_tag("icon_edit.png", width:"18px")), edit_pet_tracker_path(@pet, pet_tracker) %></td>
          <td class="text-center justify-content-center"><%= link_to (image_tag("icon_delete.png", width:"18px")), pet_tracker_path(@pet, pet_tracker), data: { turbo_method: :delete, turbo_confirm: t('.are_you_sure') } %></td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
<h5 class="text-center" style="color:#4c5ada;"><%= t '.update_instruction_html', icon: image_tag("icon_edit.png", width:"18px") %></h5>
