<div class="container">
  <%= form_with(model: [@pet, tracker]) do |form| %>
    <div class="d-flex justify-content-center">
       <%= render 'shared/errors', obj: @tracker %>
    </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.input_date'), class: "col-sm-3 col-form-label", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-4">
          <%= form.date_field :date, class: "form-control", value: set_current_date, max: set_current_date, min: @pet.birthday %>
        </div>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.select'), class: "col-sm-3 col-form-label optional", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-4">
          <%= form.select :hungry_extend, [["Yes"], ["Ate A Little"], ["No"]], { :include_blank => "Is he/she hungry? Please choose..." }, class: "form-control" %>
        </div>
      </div>

      <div class="row mb-3 justify-content-center" data-controller="time-zone">
        <%= form.label t('.feeding_time'), class: "col-sm-3 col-form-label", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-4">
          <%= form.time_field :feeding_time, class: "form-control", value: set_current_time %>
        </div>
      </div>


      <div class="row mb-3 justify-content-center">
        <%= form.label t('.food_type'), class: "col-sm-3 col-form-label required", style: "color: #515a5a; font-weight: bold;" %>
        <div class="col-sm-4">
          <%= form.select :food_type, [["Dry"], ["Wet"], ["Other"]], { :include_blank => "Select Food Type" }, class: "form-control", required: true %>
        </div>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.brand'), class: "col-sm-3 col-form-label required", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-4">
          <%= form.text_field :brand, class: "form-control", value: tracker.brand, requried: true %>
        </div>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.description'), class: "col-sm-3 col-form-label required", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-4">
          <%= form.text_field :description, class: "form-control", value: tracker.description, requried: true %>
          <div id="descriptionHelpBlock" class="form-text"><%= t('.description_help') %></div>
        </div>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.amount'), class: "col-sm-3 col-form-label required", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-4">
          <%= form.text_field :amount, class: "form-control floatingInput", placeholder: t('.amount_placeholder'), required: true, max: 500, min: 0 %>
          <div id="amountHelpBlock" class="form-text"><%= t '.amount_help' %></div>
        </div>
      </div>

      <div class="d-flex justify-content-center">
        <%= form.submit(@tracker.new_record? ? 'Add a new record' : "Update", class: "btn", style: "color: #515a5a; font-weight: bold; background-color: #d5dbdb") %>
      </div>
    </div>
  <% end %>
</div>