<div class="d-flex justify-content-center">
  <h1 class="text-center mt-4" style="font-weight: bold;"><%= t(".title", pet_name: @pet.pet_name.capitalize) %></h1>
</div>

<div class="d-flex float-sm-center justify-content-center mb-4">
  <%= link_to "#{image_tag('icon_add.png', width:'18px', height: '18px')}  #{t(".add_record", pet_name: @pet.pet_name.capitalize)}".html_safe, new_pet_tracker_path %>
</div>

<fieldset>
  <%= link_to "#{image_tag('download.png', width:'25px', height: '25px')} #{t(".export_csv")}".html_safe, pet_trackers_path(format: :csv), class:"d-flex justify-content-center mb-3", style: "color: #515a5a; font-weight: bold;", download: [@pet.pet_name.capitalize, "trackers", Date.today].join('_') %>
</fieldset>


<div class="d-flex digg_pagination justify-content-center">
  <div class="page_info">
    <%= page_entries_info @trackers %>
  </div>
</div>

<div class="d-flex digg_pagination justify-content-center mb-4">
  <%= will_paginate @trackers, :container => false %>
</div>

<%= render 'tracker' %>

<%= column_chart [{name: t('.chart_wet'), data: @pet.trackers.order(date: 'asc').where(food_type: "Wet").where.not(total_ate_amount: nil).group(:transformed_time).sum(:total_ate_amount)}, 
  {name: t('.chart_dry'), data: @pet.trackers.order(date: 'asc').where(food_type: "Dry").where.not(total_ate_amount: nil).group(:transformed_time).sum(:total_ate_amount)},
  {name: t('.chart_other'), data: @pet.trackers.order(date: 'asc').where(food_type: "Other").where.not(total_ate_amount: nil).group(:transformed_time).sum(:total_ate_amount)}], stacked: true %>


<div class="d-flex digg_pagination justify-content-center">
  <div class="page_info">
    <%= page_entries_info @trackers %>
  </div>
</div>
<div class="d-flex digg_pagination justify-content-center mb-5">
  <%= will_paginate @trackers, :container => false %>
</div>

<h2 class="text-center mt-4" style="font-weight: bold;"><%= t(".weight", pet_name: @pet.pet_name.capitalize) %></h2>
<%= line_chart @pet.trackers.group(:transformed_time).sum(:weight) %>