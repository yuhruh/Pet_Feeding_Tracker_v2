<div class="d-flex justify-content-center">
  <h1 class="text-center mt-4">Pet <%= @pet.pet_name.capitalize %>'s Trackers</h1>
</div>

<div class="d-flex float-sm-center justify-content-center mb-4">
  <%= link_to "#{image_tag('icon_add.png', width:'18px', height: '18px')}  Adding #{@pet.pet_name.capitalize}'s New Record".html_safe, new_pet_tracker_path %>
</div>

<fieldset>
  <%= link_to "#{image_tag('download.png', width:'25px', height: '25px')} Export to CSV".html_safe, pet_trackers_path(format: :csv), class:"d-flex justify-content-center mb-3", style: "color: #515a5a; font-weight: bold;", download: [@pet.pet_name.capitalize, "trackers", Date.today].join('_') %>
</fieldset>


<div class="d-flex digg_pagination justify-content-center">
  <div class="page_info">
    <%= page_entries_info @trackers %>
  </div>
</div>

<div class="d-flex digg_pagination justify-content-center mb-4">
  <%= will_paginate @trackers, :container => false %>
</div>

<%= render 'tracker' %>

<%= column_chart [{name: "wet ate total amount", data: @pet.trackers.where(food_type: "Wet").where.not(total_ate_amount: nil).group(:transformed_time).sum(:total_ate_amount)}, 
  {name: "dry ate total amount", data: @pet.trackers.where(food_type: "Dry").where.not(total_ate_amount: nil).group(:transformed_time).sum(:total_ate_amount)},
  {name: "other ate total amount", data: @pet.trackers.where(food_type: "Other").where.not(total_ate_amount: nil).group(:transformed_time).sum(:total_ate_amount)}], stacked: true %>

<div class="d-flex digg_pagination justify-content-center">
  <div class="page_info">
    <%= page_entries_info @trackers %>
  </div>
</div>
<div class="d-flex digg_pagination justify-content-center mb-4">
  <%= will_paginate @trackers, :container => false %>
</div>