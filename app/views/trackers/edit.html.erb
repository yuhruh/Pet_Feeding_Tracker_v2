<h1 class="text-center mt-4" style="font-weight: bold;"><%= t(".edit_title", pet_name: @pet.pet_name.capitalize) %></h1>

<div class="container">
  <%= form_with(model: [@pet, @tracker]) do |form| %>
    <div class="d-flex justify-content-center">
       <%= render 'shared/errors', obj: @tracker %>
    </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.date'), class: "col-sm-3 col-form-label", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-5">
          <%= form.date_field :date, class: "form-control", value: @tracker.date, max: @tracker.date %>
        </div>
        <%= set_current_date %>
        <%=pet_tracker.date%>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.hungry_question'), class: "col-sm-3 col-form-label", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-5">
          <%= form.select :hungry_extend, [["Yes"], ["Ate A Little"], ["No"]], { :include_blank => "Is he/she hungry? Please choose..." }, class: "form-control" %>
        </div>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.feeding_time'), class: "col-sm-3 col-form-label", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-5">
          <fieldset disabled>
            <%= form.text_field :feeding_time, class: "form-control", value: @tracker.feeding_time.strftime("%H:%M") %>
            <div id="feedin_timeHelpBlock" class="form-text"><%= t('.feeding_note') %></div>
          </fieldset>
        </div>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.eat_back_time'), class: "col-sm-3 col-form-label optional", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-5">
          <%= form.text_field :time_of_eat_back_and_forth, class: "form-control", placeholder: t('.eat_back_placeholder') %>
          <div id="time_of_eat_back_and_forthHelpBlock" class="form-text"><%= t('.eat_back_note') %></div>
        </div>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.food_type'), class: "col-sm-3 col-form-label required", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-5">
           <%= form.select :food_type, [["Dry"], ["Wet"], ["Other"]], { :include_blank => "Select Food Type" }, class: "form-control", required: true %>
        </div>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.brand'), class: "col-sm-3 col-form-label required", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-5">
          <%= form.text_field :brand, class: "form-control", value: @tracker.brand %>
        </div>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.description'), class: "col-sm-3 col-form-label required", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-5">
          <%= form.text_field :description, class: "form-control" %>
        </div>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.amount'), class: "col-sm-3 col-form-label required", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-5">
          <%= form.number_field :amount, step: :any, class: "form-control floatingInput" %>
        </div>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.left_amount'), class: "col-sm-3 col-form-label required", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-5">
          <%= form.number_field :left_amount, step: :any, class: "form-control floatingInput", required: true, max: @tracker.amount, min: 0 %>
        </div>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.love_extend'), class: "col-sm-3 col-form-label required", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-5">
          <%= form.select :love_extend, [["Love it So Much"], ["So so"], ["Not Like it"]], { :include_blank => "Does she/he love this food?" }, class: "form-control", required: true %>
        </div>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.weight'), class: "col-sm-3 col-form-label optional", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-5">
          <%= form.number_field :weight, step: :any, class: "form-control floatingInput", placeholder: t('.weight_placeholder'), max: 100, min: 0.0 %>
          <div id="weightHelpBlock" class="form-text"><%= t '.weight_note' %></div>
        </div>
      </div>

      <div class="row mb-3 justify-content-center">
        <%= form.label t('.note'), class: "col-sm-3 col-form-label optional", style: "color: #515a5a; font-weight: bold" %>
        <div class="col-sm-5">
          <%= form.text_field :note, class: "form-control floatingInput" %>
          <div id="noteHelpBlock" class="form-text"><%= t '.note_help' %></div>
        </div>
      </div>

      <div class="d-flex justify-content-center">
        <%= form.submit(@tracker.new_record? ? t('.submit_create') : t('.submit_update'), class: "btn", style: "color: #515a5a; font-weight: bold; background-color: #d5dbdb") %>
      </div>
    </div>
  <% end %>
</div>

<br>

<div class="d-flex justify-content-center mb-4">
  <%= link_to t('.links_back'), pet_trackers_path %>
</div>
<%=@tracker.love_extend%>