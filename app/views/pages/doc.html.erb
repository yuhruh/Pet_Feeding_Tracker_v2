            <th scope="col" style="width:35%"></th>
            <th scope="col"><%= t '.col' %></th>
            <th scope="col"><%= t '.col2' %></th>
          </tr>
        </thead>
        <tbody class="table-group-divider">
          <tr>
            <th scope="row"><%= t '.row' %></th>
            <td><%= image_tag("not1.png", width:"30px")%></td>
            <td><%= image_tag("v.png", width:"30px")%></td>
          </tr>
          <tr>
            <th scope="row"><%= t '.row2' %></th>
            <td><%= image_tag("v.png", width:"30px")%></td>
            <td><%= image_tag("v.png", width:"30px")%></td>
          </tr>
          <tr>
            <th scope="row"><%= t '.row3' %></th>
            <td><%= image_tag("not1.png", width:"30px")%></td>
            <td><%= image_tag("v.png", width:"30px")%></td>
          </tr>
          <tr>
            <th scope="row"><%= t '.row4' %></th>
            <td><%= image_tag("not1.png", width:"30px")%></td>
            <td><%= image_tag("v.png", width:"30px")%></td>
          </tr>
          <tr>
            <th scope="row"><%= t '.row5' %></th>
            <td><%= image_tag("not1.png", width:"30px")%></td>
            <td><%= image_tag("v.png", width:"30px")%></td>
          </tr>
        </tbody>
      </table>

</div>

<div class="container">
