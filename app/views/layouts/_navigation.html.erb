<nav class="navbar navbar-expand-lg bg-body-tertiary mb-2">
  <div class="container-fluid">
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <div class="d-flex justify-content-end"></div>
          <ul class="navbar-nav">
            <% I18n.available_locales.each do |locale| %>
              <li class="nav-link active"><%= link_to locale_to_word_flag(locale), url_for(locale: locale), class: "nav-link active #{(locale == I18n.locale ? 'border-bottom' : '')}" %></li>
            <% end %>
          </ul>
        </div>
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/home"><%= t "home" %></a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/about"><%= t "about" %></a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/doc"><%= t "doc" %></a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/started"><%= t "started" %></a>
        </li>

          
        <% if logged_in? %>
          <% if current_user.pets.count != 0 %>
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="/pets"><%= current_user.name.capitalize %><%= t 'pet_list' %></a>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false"><%= t 'pets_profile' %></a>
              <ul class="dropdown-menu">
                <% current_user.pets.each do |pet| %>
                  <li>
                    <%= link_to t('view_pets', pet: pet.pet_name).html_safe, "/pets/#{pet.id}", class: "dropdown-item" %>
                  </li>
                <% end %>
              </ul>
            </li>

            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false"><%= t 'food_list' %></a>
              <ul class="dropdown-menu">
                <% current_user.pets.each do |pet| %>
                  <li>
                    <%= link_to t('view_favorite_list', pet: pet.pet_name).html_safe, "/pets/#{pet.id}/favorites", class: "dropdown-item" %>
                  </li>
                <% end %>
              </ul>
            </li>
          
    
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false"><%= t 'tracker_record' %></a>
              <ul class="dropdown-menu">
                <% current_user.pets.each do |pet| %>
                  <li>
                    <%= link_to t('view_records', pet: pet.pet_name).html_safe, "/pets/#{pet.id}/trackers", class: "dropdown-item" %>
                  </li>
                <% end %>
              </ul>
            </li>
          <% end %>

          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <%= "(Admin)" if current_user.admin %><%= t 'user_profile' %><%= current_user.name.split(" ").map(&:capitalize).join(' ') %>
            </a>
            <ul class="dropdown-menu">
              <li>
                <%= link_to t('add_pet'), new_pet_path, class: "dropdown-item" %>
              </li>
              <li>
                <%= link_to t('view_user_profile'), user_path(current_user), class: "dropdown-item" %>
              </li>
              <li>
                <%= link_to t('edit_user_profile'), edit_user_path(current_user), class: "dropdown-item" %>
              </li>
              <li>
                <%= link_to t('delete_user'), user_path(current_user), class: "dropdown-item text-danger", data: {"turbo-confirm": "Are you sure to delete your account? The whole data you created will gone...", "turbo-method": :delete } %>
              </li>
            </ul>
          </li>

          <li class="nav-item">
            <%= link_to t('logout'), logout_path, class: "nav-link", method: :delete %>
          </li>
        <% else %>
          <li class="nav-item">
            <a class="nav-link" href="/login"><%= t 'log_in' %></a>
          </li>
          <li class="nav-item">
            <a class="nav-link" aria-current="page" href="/signup"><%= t 'signup'%></a>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>