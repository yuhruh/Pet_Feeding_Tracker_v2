<div id="<%= dom_id pet %>" class='text-center'>
  <p>
    <strong><%= t '.name' %></strong>
    <%= pet.pet_name %>
  </p>

  <p>
    <strong><%= t '.birthday' %></strong>
    <% if pet.birthday.nil? %>
      <%= t('.registered') %>
    <% else %>
      <%= pet.birthday.strftime("%Y-%m-%d") %>
    <% end %>
  </p>

  <p>
    <strong><%= t '.weight' %></strong>
    <%= pet.weight %>
  </p>

  <p>
    <strong><%= t '.gender' %></strong>
    <%= pet.gender %>
  </p>

  <p>
    <strong><%= t '.breed' %></strong>
    <%= pet.breed %>
  </p>

  <p>
    <strong><%= t '.owner' %></strong>
    <%= current_user.name.capitalize %>
  </p>

</div>

