<div id="<%= dom_id pet %>" class='text-center'>
  <p>
    <strong>Pet name:</strong>
    <%= pet.pet_name %>
  </p>

  <p>
    <strong>Birthday:</strong>
    <% if pet.birthday.nil? %>
      <%= "Not registered yet" %>
    <% else %>
      <%= pet.birthday.strftime("%Y-%m-%d") %>
    <% end %>
  </p>

  <p>
    <strong>Weight (kg) :</strong>
    <%= pet.weight %>
  </p>

  <p>
    <strong>Gender:</strong>
    <%= pet.gender %>
  </p>

  <p>
    <strong>Breed:</strong>
    <%= pet.breed %>
  </p>

  <p>
    <strong>Owner:</strong>
    <%= current_user.name.capitalize %>
  </p>

</div>

