<h1 class="text-center mt-4"><%= t('.title', pet: @pet.pet_name).html_safe %></h1>


  <%= form_with(model: @pet) do |form| %>
    <div class="d-flex justify-content-center">
       <%= render 'shared/errors', obj: @pet %>
    </div>

    <div class="col-12">
      <div class="row mb-4 justify-content-center">
      <%= form.label t('.birthday'), class: "col-sm-1 col-form-label", style: "color: #515a5a; font-weight: bold" %>
      <div class="col-sm-2">
        <%= form.date_field :birthday, class: "form-control" %>
      </div> 
    </div>

    <div class="col-12">
      <div class="row mb-4 justify-content-center">
      <%= form.label t('.weight'), class: "col-sm-1 col-form-label", style: "color: #515a5a; font-weight: bold" %>
      <div class="col-sm-2">
        <%= form.number_field :weight, step: :any, class: "form-control", placeholder: t('.placeholder_weight'), max: 100, min: 0 %>
      </div> 
    </div>

    <div class="col-12">
      <div class="row mb-4 justify-content-center">
      <%= form.label t('.gender'), class: "col-sm-1 col-form-label", style: "color: #515a5a; font-weight: bold" %>
      <div class="col-sm-2">
        <%= form.select :gender, [[t('.male')], [t('.female')], [t('.not_answer')]], { prompt: t('.prompt_gender') }, class: "form-control" %>
      </div> 
    </div>

    <div class="col-12">
      <div class="row mb-4 justify-content-center">
      <%= form.label t('.breed'), class: "col-sm-1 col-form-label", style: "color: #515a5a; font-weight: bold" %>
      <div class="col-sm-2">
        <%= form.text_field :breed, class: "form-control", placeholder: t('.placeholder_breed') %>
      </div> 
    </div>

    <div class="d-flex justify-content-center">
      <%= form.submit(@pet.new_record? ? t('.button_add') : t('.button_modify'), class: "btn", style: "color: #515a5a; font-weight: bold; background-color: #d5dbdb") %>
    </div>
  <% end %>


<br>

<div class="d-flex justify-content-center mb-4">
  <%= link_to t('.show'), @pet %> |
  <%= link_to t('.back'), pets_path %>
</div>
