<% content_for :title, "Pets" %>

<h1 class='text-center' style="font-weight: bold;"><%= current_user.name.capitalize %><%= t '.title' %></h1>

<div class="d-flex justify-content-center mb-5">
  <%= link_to "#{image_tag('add_pet.png', width:'25px', height:'25px')} #{t '.button_add'}".html_safe, new_pet_path %>
</div>

<div class="d-flex digg_pagination justify-content-center">
  <div class="page_info">
    <%= page_entries_info @pets %>
  </div>
</div>
<div class="d-flex digg_pagination justify-content-center mb-4">
  <%= will_paginate @pets, :container => false %>
</div>

<div id="pets" class='d-flex justify-content-center'>
  <% if @pets.find_by(user_id: current_user.id).nil? %>
    <h5 class="text-center"><%= t '.h5_1' %><%= image_tag('add_pet.png', width:'25px', height:'25px') %><%= t '.h5_2' %></h5>
  <% else %>
    <% @pets.each do |pet| %>
      <div class="card mb-3" style="width: 40rem; background: #f2f4f6">
        <%= render pet %>
        <p class="text-center">
          <%= link_to t('.show_list'), pet %>
        </p>
      </div>
    <% end %>
  <% end %>
</div>

<div class="d-flex digg_pagination justify-content-center">
  <div class="page_info">
    <%= page_entries_info @pets %>
  </div>
</div>
<div class="d-flex digg_pagination justify-content-center mb-4">
  <%= will_paginate @pets, :container => false %>
</div>
